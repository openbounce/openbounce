{
  "name": "@openbounce/core",
  "version": "0.1.0",
  "description": "Open-source email verification engine — syntax, MX/DNS, SMTP mailbox probing, catch-all, disposable/role/free detection, and typo suggestions. Local-first, no paid API.",
  "keywords": [
    "email",
    "email-validation",
    "email-verification",
    "smtp",
    "mx",
    "disposable-email",
    "catch-all",
    "verifier",
    "zerobounce"
  ],
  "license": "MIT",
  "author": "Sharvil Kadam",
  "homepage": "https://github.com/openbounce/openbounce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbounce/openbounce.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/openbounce/openbounce/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  }
}
