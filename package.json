{
  "name": "openbounce-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for openbounce — open-source, local-first email verification (the flagship `openbounce` package + `@openbounce/core` engine).",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke.mjs",
    "bench": "pnpm run bench:accuracy && pnpm run bench:perf",
    "bench:accuracy": "node bench/accuracy.mjs",
    "bench:perf": "node --expose-gc bench/perf.mjs",
    "release": "pnpm -r build && pnpm -r publish",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:next",
    "typecheck:next": "node node_modules/typescript-next/bin/tsc -p packages/core/tsconfig.json --noEmit && node node_modules/typescript-next/bin/tsc -p packages/cli/tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@openbounce/core": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "fast-check": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "openbounce": "workspace:*",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.0",
    "typescript-next": "npm:typescript@^7.0.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.0"
  }
}
